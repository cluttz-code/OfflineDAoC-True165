<Project Sdk="Microsoft.NET.Sdk">
  <!-- The cross-platform command-line launcher (macOS and Linux): the Windows launcher's START SERVER, --refresh-165,
       --add-bots and ENTER REALM steps without its window. It shares TrueMode, BotCharacterGenerator and BotRoster with
       OfflineDaoc.Launcher, so both write the world exactly the same way. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>offlinedaoc</AssemblyName>
    <RootNamespace>OfflineDaoc.Launcher</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <Compile Include="../OfflineDaoc.Launcher/TrueMode.cs" Link="Shared/TrueMode.cs" />
    <Compile Include="../OfflineDaoc.Launcher/BotCharacterGenerator.cs" Link="Shared/BotCharacterGenerator.cs" />
    <Compile Include="../OfflineDaoc.Launcher/BotRoster.cs" Link="Shared/BotRoster.cs" />
  </ItemGroup>
</Project>
